# ------------------------------------------------------------------
# MovieVerse — variables de entorno (backend + docker compose)
# Copiar a `.env` y completar. `.env` NUNCA se sube al repositorio.
# ------------------------------------------------------------------

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=true
SECRET_KEY=change-me-in-your-local-env
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (backend corriendo fuera de Docker contra el Postgres de compose)
DATABASE_URL=postgres://movieverse:movieverse@localhost:5432/movieverse

# CORS (orígenes del frontend, separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# TMDB (sólo backend). Acepta API Key v3 o API Read Access Token v4.
TMDB_API_KEY=
TMDB_LANGUAGE=es-ES
TMDB_TIMEOUT_SECONDS=5
# Días antes de volver a pedir metadata/créditos a TMDB (cache en PostgreSQL)
TMDB_CACHE_DAYS=7

# Docker compose — PostgreSQL local (sólo desarrollo)
POSTGRES_DB=movieverse
POSTGRES_USER=movieverse
POSTGRES_PASSWORD=movieverse
# Puertos expuestos en el host (cambiarlos si ya están ocupados)
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
